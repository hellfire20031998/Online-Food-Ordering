# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Database (jdbc:mysql://... or jdbc:postgresql://...)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/my_restaurant
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeme

# JWT — long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=changeme
JWT_EXPIRATION_MS=86400000

# Comma-separated allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
