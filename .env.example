# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Database (jdbc:mysql://... or jdbc:postgresql://...)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/my_restaurant
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeme

# JWT — long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=changeme
JWT_EXPIRATION_MS=86400000

# Comma-separated allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First platform team admin, created at startup if the email does not exist yet.
# Leave both empty to skip seeding.
TEAM_ADMIN_NAME=Platform Admin
TEAM_ADMIN_EMAIL=admin@example.com
TEAM_ADMIN_PASSWORD=changeme

# Default platform commission (percent); editable later from the team console
PLATFORM_DEFAULT_COMMISSION=10

# Public URL of the React app, used for links in emails
FRONTEND_URL=http://localhost:3000

# Encrypts bank account numbers / UPI ids at rest (AES-256-GCM). Random string, at least 32 chars,
# e.g. `openssl rand -base64 48`. Unique per environment.
DATA_ENCRYPTION_KEY=changeme-to-a-random-string-of-at-least-32-characters
# When rotating: put the previous key(s) here, comma-separated, then re-encrypt from the team console.
DATA_ENCRYPTION_PREVIOUS_KEYS=
# Refuse to start with a weak/default key. Set to true in production.
ENFORCE_STRONG_ENCRYPTION_KEY=false

# Online payments: none (cash on delivery only) | stripe
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From the Stripe dashboard webhook endpoint (or `stripe listen --forward-to localhost:8080/api/payments/webhook/stripe`)
STRIPE_WEBHOOK_SECRET=whsec_...

# Email provider: log | smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=Foodiyapa <your.address@gmail.com>
# Gmail SMTP: use a Google App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Amazon SES via SMTP instead: SMTP_HOST=email-smtp.ap-south-1.amazonaws.com and the SES SMTP credentials
# Resend instead: EMAIL_PROVIDER=resend and RESEND_API_KEY=re_...
RESEND_API_KEY=
